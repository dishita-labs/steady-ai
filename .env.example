# Steady environment variables. Copy to .env and fill in. Never commit real values.
# A set variable does not mean the integration works; see docs/decisions.md.

# --- API ---
# Every /api route requires `Authorization: Bearer $STEADY_API_TOKEN`. The API is disabled when unset.
STEADY_API_TOKEN=
# Uploads and JSONL records live here (default .data).
STEADY_DATA_DIR=.data
# Force a recorder: "singlestore" or "jsonl". Default: singlestore when SINGLESTORE_* is set, else jsonl.
STEADY_RECORDER=

# --- Workflow SDK (local world) ---
# Run state for local development (default .workflow-data). View with `aube run workflow:web`.
WORKFLOW_LOCAL_DATA_DIR=

# --- Superlinked SIE: Gemma 4 31B (vision) and GLiNER2.5 Decide (typed decisions) ---
SIE_API_KEY=
# Leave blank for SIE Serverless. Set for a self-hosted SIE server.
SIE_BASE_URL=
# Add a profile suffix after evaluation, e.g. google/gemma-4-31B-it:h100-96k-hires-out8k-no-spec
SIE_VISION_MODEL=google/gemma-4-31B-it
SIE_DECIDE_MODEL=fastino/GLiNER2.5-Decide

# --- Exa: product discovery and page content ---
EXA_API_KEY=

# --- SingleStore (MySQL wire protocol, via mysql2) ---
SINGLESTORE_HOST=
SINGLESTORE_PORT=3306
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=steady
# TLS is on by default (required for SingleStore Helios). Set to false only for a local cluster.
SINGLESTORE_SSL=

# --- Shopping ---
# "simulated" = no real retailer or cart is touched, and every action is labeled simulated.
SHOPPING_MODE=simulated
