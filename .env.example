# Steady environment variables. Copy to .env.local and fill in. Never commit real values.
# Placeholders only. A set variable does not mean the integration works; see docs/decisions.md.

# --- Guild AI: agent execution and session traces (REST: https://api.guild.ai/v1) ---
# The docs don't define env var names; these are ours. The credential is <key id>:<secret>.
GUILD_API_BASE_URL=https://api.guild.ai/v1
GUILD_WORKSPACE_ID=
GUILD_AGENT_ID=
GUILD_API_KEY_ID=
GUILD_API_KEY_SECRET=

# --- Vision-language model (provider not chosen yet) ---
VISION_PROVIDER=
VISION_MODEL=
VISION_API_KEY=

# --- Exa: product discovery and page content ---
EXA_API_KEY=

# --- Superlinked SIE: GLiNER2.5 Decide classification ---
SIE_API_KEY=
# Leave blank to use the SDK default. Set this for a self-hosted SIE server.
SIE_BASE_URL=
SIE_DECIDE_MODEL=fastino/GLiNER2.5-Decide

# --- SingleStore ---
SINGLESTORE_HOST=
SINGLESTORE_PORT=3306
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=steady

# --- Shopping ---
# "simulated" = no real retailer or cart is touched, and the UI labels it.
SHOPPING_MODE=simulated
