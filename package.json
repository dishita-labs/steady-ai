{
  "name": "steady-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fnox exec -- nitro dev",
    "build": "nitro build",
    "start": "fnox exec -- node .output/server/index.mjs",
    "workflow:web": "WORKFLOW_MANIFEST_PATH=node_modules/.nitro/workflow/manifest.json workflow web",
    "db:migrate": "fnox exec -- node --experimental-strip-types scripts/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "aube run lint && aube run typecheck && aube run test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22",
    "eslint": "^10.15.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@starfederation/datastar-sdk": "^1.0.0",
    "@superlinked/sie-sdk": "^0.11.1",
    "exa-js": "^2.29.0",
    "hono": "^4.13.19",
    "mysql2": "^3.24.6",
    "nitro": "3.0.261103-rc",
    "workflow": "^5.6.1",
    "zod": "^4.6.7"
  }
}
