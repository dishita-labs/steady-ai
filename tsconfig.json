{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "plugins": [{ "name": "workflow" }]
  },
  "include": ["src", "tests", "scripts", "*.ts", "*.mts"],
  "exclude": ["node_modules", ".output", ".nitro", ".data", ".workflow-data"]
}
